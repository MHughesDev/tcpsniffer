{
  "name": "tcp-sniffer",
  "version": "0.1.0",
  "type": "module",
  "description": "TCP Sniffer — capture-only library with C++ engine; TS API per docs/OVERVIEW.md",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "binding.gyp", "native"],
  "repository": { "type": "git", "url": "https://github.com/MHughesDev/tcpsniffer.git" },
  "homepage": "https://github.com/MHughesDev/tcpsniffer#readme",
  "bugs": { "url": "https://github.com/MHughesDev/tcpsniffer/issues" },
  "scripts": {
    "build": "tsc",
    "build:native": "node-gyp configure build",
    "rebuild": "node-gyp rebuild",
    "prepare": "npm run build",
    "install": "node-gyp rebuild || true",
    "start": "node dist/entrypoint.js",
    "demo": "node dist/demo.js",
    "test": "node --test dist/tests/unit/*.test.js dist/tests/integration/*.test.js dist/tests/e2e/*.test.js",
    "test:ts": "tsc && npm run test",
    "test:unit": "tsc && node --test dist/tests/unit/*.test.js",
    "test:integration": "tsc && node --test dist/tests/integration/*.test.js",
    "test:e2e": "tsc && node --test dist/tests/e2e/*.test.js",
    "test:injector": "npm --prefix injector run test:ts",
    "test:all": "npm run test:ts && npm run test:injector"
  },
  "keywords": ["tcp", "sniffer", "libpcap", "http", "kubernetes", "sidecar"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
