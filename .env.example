# TCP Sniffer runtime configuration (root package)
# Copy to .env for local development (never commit real secrets).

# Comma-separated list of ports to capture (required by entrypoint).
PORTS=8080

# Optional capture interface (empty = engine default).
INTERFACE=

# Optional output URL (set to HTTPS in production).
OUTPUT_URL=

# Optional auth token used for OUTPUT_URL bearer auth.
OUTPUT_URL_AUTH_TOKEN=

# Write JSON messages to stdout (true/false).
OUTPUT_STDOUT=true

# Production guardrails (HTTPS required for OUTPUT_URL when enabled).
NODE_ENV=development
TCP_SNIFFER_PRODUCTION=0
